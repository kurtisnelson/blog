---
layout: base
title: Home
pagination:
  data: collections.posts
  size: 10
  alias: posts
permalink: /{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}
eleventyNavigation:
  key: Home
  order: 0
---

<h1>Posts</h1>

{% if posts.length %}
  <ul class="post-list">
    {% for post in posts %}
      <li class="post-list-item">
        <a href="{{ post.url | url }}">{{ post.data.title }}</a>
        <time class="post-date">{{ post.date | readableDate }}</time>
        {% if post.data.tags and post.data.tags.length %}
          <span class="post-tags">
            {% for tag in post.data.tags %}
              <a href="{{ ('/tags/' + (tag | slug) + '/') | url }}">{{ tag }}</a>
            {% endfor %}
          </span>
        {% endif %}
      </li>
    {% endfor %}
  </ul>

  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous | url }}">Newer Posts</a>
  {% endif %}
  {% if pagination.href.next %}
    <a href="{{ pagination.href.next | url }}">Older Posts</a>
  {% endif %}
{% else %}
  <p>No posts yet.</p>
{% endif %}
