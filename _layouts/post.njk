---
layout: base
---

<article class="post">
  <h1>{{ title }}</h1>
  <time datetime="{{ date | isoDate }}">{{ date | fullDate }}</time>

  {% if tags and tags.length %}
    <div class="post-tags">
      {% for tag in tags %}
        <a href="/tags/{{ tag | slug }}/">{{ tag }}</a>
      {% endfor %}
    </div>
  {% endif %}

  <div class="post-content">{{ content | safe }}</div>
</article>
