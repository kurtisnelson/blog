<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>{{ title }} | Kurt Nelson's Blog</title>
    <link rel="stylesheet" href="/assets/css/style.css" />
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="site-title">Kurt Nelson's Blog</a>
        <nav class="site-nav">
          <a href="/">Home</a>
          <a href="/posts/">All Posts</a>
        </nav>
      </div>
    </header>

    <main class="container">{{ content | safe }}</main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; <span id="year"></span> Kurt Nelson. Built with <a href="https://www.11ty.dev/">Eleventy</a>.</p>
      </div>
      <script>document.getElementById("year").textContent = new Date().getFullYear();</script>
    </footer>
  </body>
</html>
